{
  "buildCommand": "npm --workspace apps/backend run build",
  "installCommand": "npm install",
  "outputDirectory": "api",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
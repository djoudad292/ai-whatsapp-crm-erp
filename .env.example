# --- Environment variables ---
# Copy this file to .env and fill in values as needed.

# --- Common ---
NODE_ENV=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm

# --- Odoo ---
ODOO_HOST=odoo_db
ODOO_PORT=8069

# --- Backend ---
BACKEND_PORT=3000
DATABASE_URL=postgres://postgres:postgres@postgres:5432/crm
REDIS_URL=redis://redis:6379
BACKEND_WEBHOOK_URL=http://backend:3000/webhooks/whatsapp

# --- Frontend ---
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_WEBHOOK_URL=http://localhost:3000/webhooks/whatsappTELEGRAM_BOT_TOKEN=
